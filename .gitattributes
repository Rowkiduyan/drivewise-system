# Normalize all text files to LF in the repository, regardless of what a
# given contributor's OS/editor/tool wrote on disk -- avoids the
# "fatal: LF would be replaced by CRLF" safecrlf error that hits any LF-only
# file in a repo relying only on core.autocrlf (Windows checkouts still get
# CRLF locally; only the stored/committed line ending is forced to LF).
* text=auto eol=lf

# Binary assets -- never text-normalized or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
